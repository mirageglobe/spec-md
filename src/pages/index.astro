---
import Layout from '../layouts/Layout.astro';

const repo = 'https://github.com/mirageglobe/spec-md';
const curl = 'curl -O https://raw.githubusercontent.com/mirageglobe/spec-md/main/template/SPEC.md';

// the four required sections, as cards
const required = [
  { name: 'architecture', gives: 'system design, components, boundaries' },
  { name: 'roadmap', gives: 'open tasks scoped by component and difficulty' },
  { name: 'decisions', gives: 'what was chosen and why; stops re-litigation' },
  { name: 'complexity score', gives: 'how carefully to tread, per layer' },
];

// optional sections, shown as chips
const optional = [
  'overview', 'technology stack', 'principles', 'constraints', 'non-goals', 'file structure',
  'build & run', 'milestones', 'open questions', 'risks', 'releasing', 'key bindings',
];

// the problem, as no-x-means-y pairs
const problems = [
  ['no architecture context', 'wrong abstractions'],
  ['no decision log', 'past choices relitigated'],
  ['no roadmap tags', 'wrong tasks picked up'],
  ['no complexity score', 'too light or too heavy a touch'],
];

// the agent angle, one card each
const agent = [
  { label: 'scope', tags: ['[api]', '[cli]', '[ui]'], text: 'component tags tell an agent exactly which subsystem a task belongs to. no guessing, no sprawl.' },
  { label: 'select', tags: ['[easy]', '[medium]', '[hard]'], text: 'difficulty tags let agents self-select suitable tasks without human triage.' },
  { label: 'trust', tags: [], text: 'the decisions section is a settled record. agents read it and move on instead of proposing alternatives.' },
  { label: 'calibrate', tags: [], text: 'a 4/5 storage layer gets different care than a 1/5 config file. the score says how careful to be before touching anything.' },
];
---

<Layout title="spec-md">
  <style>
    /* nav */
    .nav { position: sticky; top: 0; z-index: 10; backdrop-filter: blur(10px); background: color-mix(in srgb, var(--bg) 78%, transparent); border-bottom: 1px solid var(--border); }
    .nav-in { display: flex; align-items: center; justify-content: space-between; height: 58px; }
    .brand { font-family: var(--mono); font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
    .brand b { color: var(--accent); }
    .nav-links { display: flex; gap: 1.5rem; align-items: center; font-size: 0.9rem; }
    .nav-links a { color: var(--muted); }
    .nav-links a:hover { color: var(--text); text-decoration: none; }
    .nav-links .pill { color: var(--text); border: 1px solid var(--border); padding: 0.3rem 0.8rem; border-radius: 999px; }
    .nav-links .pill:hover { border-color: var(--accent); color: var(--accent); }
    @media (max-width: 640px) { .nav-links .hide-sm { display: none; } }

    /* hero */
    .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: 3rem; align-items: center; padding: 5.5rem 0 4.5rem; }
    @media (max-width: 880px) { .hero { grid-template-columns: 1fr; padding-top: 3.5rem; } }
    /* let grid children shrink so wide code never widens the page on mobile */
    .hero > * { min-width: 0; }
    .cmd { min-width: 0; }
    .eyebrow { display: inline-flex; gap: 0.5rem; align-items: center; font-family: var(--mono); font-size: 0.78rem; color: var(--muted); border: 1px solid var(--border); background: var(--surface); padding: 0.3rem 0.75rem; border-radius: 999px; margin-bottom: 1.5rem; }
    .eyebrow i { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 8px var(--green); }
    h1 { font-size: clamp(2.2rem, 5.2vw, 3.6rem); line-height: 1.08; letter-spacing: -0.035em; font-weight: 800; margin-bottom: 1.25rem; }
    h1 span { background: linear-gradient(100deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .sub { color: var(--muted); font-size: 1.1rem; max-width: 34rem; margin-bottom: 2rem; }
    .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem; }
    .btn { display: inline-block; padding: 0.7rem 1.25rem; border-radius: 10px; font-weight: 600; font-size: 0.95rem; border: 1px solid var(--border); color: var(--text); background: var(--surface); transition: transform 0.15s, border-color 0.15s; }
    .btn:hover { text-decoration: none; transform: translateY(-1px); border-color: var(--accent); }
    .btn.primary { background: linear-gradient(100deg, var(--accent), var(--accent2)); color: #1a1100; border-color: transparent; }
    .cmd { display: flex; align-items: center; gap: 0.75rem; justify-content: space-between; background: var(--code-bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.55rem 0.55rem 0.55rem 1rem; font-family: var(--mono); font-size: 0.78rem; color: var(--muted); max-width: 34rem; }
    .cmd code { overflow-x: auto; white-space: nowrap; scrollbar-width: none; }
    .cmd button { flex: none; font: inherit; font-family: var(--sans); font-size: 0.78rem; cursor: pointer; color: var(--text); background: var(--raised); border: 1px solid var(--border); border-radius: 7px; padding: 0.3rem 0.7rem; }
    .cmd button:hover { border-color: var(--accent); }

    /* spec window */
    .win { background: var(--code-bg); border: 1px solid var(--border); border-radius: 14px; box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 176, 32, 0.04); overflow: hidden; }
    .win-bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.7rem 1rem; border-bottom: 1px solid var(--border); background: var(--surface); }
    .win-bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--border); }
    .win-bar span { margin-left: 0.5rem; font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
    .win pre { padding: 1.1rem 1.25rem 1.3rem; font-size: 0.8rem; line-height: 1.7; overflow-x: auto; }
    .c { color: var(--muted); } .k { color: var(--accent); } .t { color: var(--blue); } .d { color: var(--muted); text-decoration: line-through; } .g { color: var(--green); }

    /* sections */
    section { padding: 4rem 0; }
    .kicker { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.75rem; }
    h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); letter-spacing: -0.025em; line-height: 1.2; margin-bottom: 1rem; }
    .lede { color: var(--muted); max-width: 40rem; margin-bottom: 2.25rem; }
    .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 1.25rem 1.35rem; transition: border-color 0.15s, transform 0.15s; }
    .card:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); transform: translateY(-2px); }
    .card h3 { font-size: 1rem; margin-bottom: 0.4rem; }
    .card p { color: var(--muted); font-size: 0.92rem; }
    .card code { display: inline-block; font-size: 0.8rem; color: var(--accent); background: var(--code-bg); border: 1px solid var(--border); padding: 0.05rem 0.45rem; border-radius: 6px; margin-bottom: 0.7rem; }
    .arrow { color: var(--muted); font-size: 0.85rem; }
    .arrow b { display: block; color: var(--text); font-weight: 600; font-size: 1.02rem; margin-top: 0.15rem; }
    .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
    .chips span { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); border: 1px solid var(--border); background: var(--surface); padding: 0.25rem 0.7rem; border-radius: 999px; }
    .chips-label { margin-top: 2rem; color: var(--muted); font-size: 0.9rem; }
    .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0.2rem 0 0.7rem; }
    .tags span { font-family: var(--mono); font-size: 0.75rem; color: var(--blue); background: var(--code-bg); border: 1px solid var(--border); border-radius: 6px; padding: 0.05rem 0.45rem; }

    /* start */
    .start { background: linear-gradient(180deg, var(--surface), var(--bg)); border: 1px solid var(--border); border-radius: 20px; padding: 2.75rem 2rem; text-align: center; }
    .start h2 { margin-bottom: 0.6rem; }
    .start .lede { margin: 0 auto 1.75rem; }
    .start .cmd { margin: 0 auto 1.5rem; text-align: left; }
    .start .cta-row { justify-content: center; margin: 0; }

    footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding: 2.5rem 0 3.5rem; color: var(--muted); font-size: 0.88rem; border-top: 1px solid var(--border); margin-top: 4rem; }
    footer a { color: var(--muted); }
    footer a:hover { color: var(--accent); text-decoration: none; }
    footer div { display: flex; gap: 1.5rem; }
  </style>

  <header class="nav">
    <div class="wrap nav-in">
      <a class="brand" href="#top">spec<b>-</b>md</a>
      <nav class="nav-links">
        <a class="hide-sm" href="#why">why</a>
        <a class="hide-sm" href="#schema">schema</a>
        <a class="hide-sm" href="#agents">agents</a>
        <a class="pill" href={repo}>github</a>
      </nav>
    </div>
  </header>

  <main class="wrap" id="top">
    <!-- hero -->
    <div class="hero">
      <div>
        <p class="eyebrow"><i></i> open standard · one markdown file</p>
        <h1>give your agents<br /><span>the briefing they need.</span></h1>
        <p class="sub">
          a single markdown file that tells every developer and AI agent how your codebase
          is built, what is decided, and what to work on next.
        </p>
        <div class="cta-row">
          <a class="btn primary" href="#start">get the template</a>
          <a class="btn" href={`${repo}/blob/main/examples/SPEC.md`}>see an example</a>
        </div>
        <div class="cmd">
          <code>{curl}</code>
          <button type="button" data-copy={curl}>copy</button>
        </div>
      </div>

      <div class="win" aria-label="example SPEC.md">
        <div class="win-bar"><i></i><i></i><i></i><span>SPEC.md</span></div>
<pre><code><span class="c"># SPEC - my-project</span>

<span class="k">## architecture</span>
rest api (go) → postgres → s3 for assets.

<span class="k">## roadmap</span>
- [~] <span class="t">`[api]`</span> rate limiting  <span class="c">[hard]</span>
- [ ] <span class="t">`[cli]`</span> export command  <span class="c">[medium]</span>
<span class="d">- [x] `[api]` basic crud endpoints  [easy]</span>

<span class="k">## decisions</span>
- <span class="g">**jwt over sessions**</span>: stateless;
  scales without a shared cache.

<span class="k">## complexity score</span>
| dimension | score | notes          |
| :-------- | :---- | :------------- |
| overall   | 3 / 5 | async job queue |
| storage   | 4 / 5 | custom migrations |</code></pre>
      </div>
    </div>

    <!-- problem -->
    <section id="why">
      <p class="kicker">the problem</p>
      <h2>AI agents are powerful, but blind.</h2>
      <p class="lede">
        drop one into an unfamiliar codebase and it will guess at architecture, re-litigate
        settled decisions, and pick up tasks it cannot handle, because nothing told it not to.
      </p>
      <div class="grid">
        {problems.map(([lack, result]) => (
          <div class="card arrow">{lack} →<b>{result}</b></div>
        ))}
      </div>
    </section>

    <!-- schema -->
    <section id="schema">
      <p class="kicker">the solution</p>
      <h2>four required sections. zero tooling.</h2>
      <p class="lede">
        <code>SPEC.md</code> lives in the repo root, versioned with the code, so it never drifts.
        think <code>agents.md</code> for agent behaviour, but for architecture.
      </p>
      <div class="grid">
        {required.map((s) => (
          <div class="card"><code>## {s.name}</code><h3>{s.name}</h3><p>{s.gives}</p></div>
        ))}
      </div>
      <p class="chips-label">add more when the project needs them:</p>
      <div class="chips">{optional.map((o) => <span>{o}</span>)}</div>
    </section>

    <!-- agents -->
    <section id="agents">
      <p class="kicker">built for agents</p>
      <h2>structure an agent can act on.</h2>
      <div class="grid" style="margin-top:1.5rem">
        {agent.map((a) => (
          <div class="card">
            <h3>{a.label}</h3>
            {a.tags.length > 0 && <div class="tags">{a.tags.map((t) => <span>{t}</span>)}</div>}
            <p>{a.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- start -->
    <section id="start">
      <div class="start">
        <p class="kicker">get started in 30 seconds</p>
        <h2>drop it in your repo root.</h2>
        <p class="lede">fill in each section, then point your agents at it.</p>
        <div class="cmd">
          <code>{curl}</code>
          <button type="button" data-copy={curl}>copy</button>
        </div>
        <div class="cta-row">
          <a class="btn" href={`${repo}/blob/main/template/SPEC.md`}>blank template</a>
          <a class="btn" href={`${repo}/blob/main/examples/SPEC.md`}>worked example</a>
          <a class="btn" href={`${repo}/blob/main/SPEC.md`}>the full schema</a>
        </div>
      </div>
    </section>

    <footer>
      <span>spec-md · open source</span>
      <div>
        <a href={repo}>github</a>
        <a href="https://buymeacoffee.com/mirageglobe">buy me a coffee</a>
      </div>
    </footer>
  </main>

  <script is:inline>
    // copy buttons: write the data-copy text to the clipboard and flash "copied"
    document.querySelectorAll('[data-copy]').forEach((b) => {
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copy);
          const old = b.textContent;
          b.textContent = 'copied';
          setTimeout(() => (b.textContent = old), 1500);
        } catch (e) {}
      });
    });
  </script>
</Layout>
